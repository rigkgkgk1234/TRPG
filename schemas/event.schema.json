        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "any"
            },
            "of": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "type",
            "of"
          ],
          "additionalProperties": false
        }
