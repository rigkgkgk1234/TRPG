{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/EventDef",
  "definitions": {
    "EventDef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/EventId"
        },
        "category": {
          "$ref": "#/definitions/EventCategory"
        },
        "region": {
          "$ref": "#/definitions/RegionId"
        },
        "npc": {
          "type": "string",
          "description": "npc 이벤트의 대상 NPC: hamon · brock · lena · magda · toby (labels.ts의 NPC_IDS)"
        },
        "title": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Condition"
          }
        },
        "weight": {
          "type": "number"
        },
        "priority": {
          "type": "number",
          "description": "story 이벤트 우선순위 (높을수록 먼저)"
        },
        "repeat": {
          "$ref": "#/definitions/RepeatRule"
        },
        "dangerTier": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ]
        },
        "startScene": {
          "$ref": "#/definitions/SceneId"
        },
        "scenes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/SceneDef"
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "title",
        "conditions",
        "weight",
        "repeat",
        "startScene",
        "scenes"
      ],
      "additionalProperties": false
    },
    "EventId": {
      "type": "string"
    },
    "EventCategory": {
      "type": "string",
      "enum": [
        "story",
        "morning",
        "explore",
        "npc",
        "night"
      ]
    },
    "RegionId": {
      "type": "string",
      "enum": [
        "village",
        "forest",
        "watchtower",
        "marsh",
        "rowen"
      ]
    },
