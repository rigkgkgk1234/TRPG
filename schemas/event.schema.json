              "$ref": "#/definitions/JobId"
            }
          },
          "required": [
            "type",
            "job"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wound"
            },
            "max": {
              "$ref": "#/definitions/WoundLevel"
            }
          },
          "required": [
            "type",
            "max"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "fatigue"
            },
            "max": {
              "type": "number"
            },
            "min": {
              "type": "number"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "trait"
            },
            "trait": {
              "$ref": "#/definitions/TraitId"
            }
          },
          "required": [
            "type",
            "trait"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "chance"
            },
            "p": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "p"
          ],
          "additionalProperties": false
