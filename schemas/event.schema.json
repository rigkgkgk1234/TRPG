            {
              "$ref": "#/definitions/SceneId"
            },
            {
              "type": "string",
              "const": "END"
            }
          ],
          "description": "다음 장면 ID, 또는 \"END\"로 이벤트 종료"
        }
      },
      "required": [
        "next"
      ],
      "additionalProperties": false
    },
