            "type": {
              "type": "string",
              "const": "setFlag"
            },
            "flag": {
              "$ref": "#/definitions/FlagId"
            },
            "value": {
              "type": [
                "boolean",
                "number"
              ]
            }
          },
          "required": [
            "type",
