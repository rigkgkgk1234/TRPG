    "FlagId": {
      "type": "string"
    },
    "StatId": {
      "type": "string",
      "enum": [
        "str",
        "agi",
        "con",
        "per",
        "cha"
      ]
    },
    "SkillId": {
      "type": "string",
      "enum": [
        "blade",
        "blunt",
        "bow",
        "guard",
        "farming",
        "smithing",
        "tracking",
        "herbalism"
      ]
    },
    "ItemId": {
      "type": "string",
      "description": "콘텐츠 ID. 데이터 파일의 키와 일치해야 한다."
    },
    "JobId": {
      "type": "string",
      "enum": [
        "farmer",
        "smith",
        "hunter",
        "herbalist",
        "errand"
      ]
    },
    "WoundLevel": {
      "type": "string",
      "enum": [
        "none",
        "light",
        "serious",
        "critical"
      ]
    },
    "TraitId": {
      "type": "string"
    },
    "RepeatRule": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "once"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "cooldown"
            },
            "days": {
              "type": "number"
            }
          },
          "required": [
            "mode",
            "days"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "always"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SceneId": {
      "type": "string"
    },
    "SceneDef": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/definitions/TextBlock"
        },
        "onEnter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChoiceDef"
          },
          "description": "비어 있으면 \"계속\" 버튼 → autoNext"
        },
        "autoNext": {
          "anyOf": [
            {
              "$ref": "#/definitions/SceneId"
            },
            {
              "type": "string",
              "const": "END"
            }
          ]
        }
      },
      "required": [
        "text",
        "choices"
      ],
      "additionalProperties": false
    },
    "TextBlock": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "variants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "when": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/Condition"
                    }
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "when",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "fallback": {
              "type": "string"
            }
          },
          "required": [
            "variants",
            "fallback"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Effect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "silver"
            },
