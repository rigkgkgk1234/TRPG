        "player",
        "enemy",
        "roll"
      ]
    },
    "EndingId": {
      "type": "string",
      "enum": [
        "shield_of_village",
        "flee_together",
        "rowen_spearman",
        "hero_party",
        "survivor",
        "debtor",
        "death"
      ]
    },
    "ChoiceDef": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "check": {
              "not": {}
            },
            "outcome": {
              "$ref": "#/definitions/Outcome"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              },
              "description": "표시·활성 조건"
            },
            "hideIfLocked": {
              "type": "boolean",
              "description": "조건 미충족 시 숨김 (기본 false → 잠김 표시)"
            },
            "lockedReason": {
              "type": "string",
              "description": "잠김 사유 문구 (생략 시 조건에서 자동 생성)"
            },
            "cost": {
              "$ref": "#/definitions/ChoiceCost"
            }
          },
          "required": [
            "id",
            "label",
            "outcome"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "check": {
              "$ref": "#/definitions/CheckSpec"
            },
            "outcomes": {
              "$ref": "#/definitions/OutcomeMap"
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              },
              "description": "표시·활성 조건"
            },
            "hideIfLocked": {
              "type": "boolean",
              "description": "조건 미충족 시 숨김 (기본 false → 잠김 표시)"
            },
            "lockedReason": {
              "type": "string",
              "description": "잠김 사유 문구 (생략 시 조건에서 자동 생성)"
            },
            "cost": {
              "$ref": "#/definitions/ChoiceCost"
            }
          },
          "required": [
            "check",
            "id",
            "label",
            "outcomes"
          ]
        }
      ]
    },
