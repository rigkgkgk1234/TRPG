      ],
      "choices": []
    },
    "win": {
      "text": "늑대가 쓰러졌다. 떨리는 숨을 고르고 다시 탑을 올려다보았다.",
      "onEnter": [
        {
          "type": "incFlag",
          "flag": "wolves_killed",
