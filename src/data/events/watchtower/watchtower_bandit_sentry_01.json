{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "watchtower_bandit_sentry_01",
  "category": "explore",
  "region": "watchtower",
  "title": "도적 보초",
  "conditions": [
    {
      "type": "dayRange",
      "min": 6
    }
  ],
  "weight": 6,
  "repeat": {
    "mode": "cooldown",
    "days": 6
  },
  "dangerTier": 2,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "무너진 담 위에 도적 하나가 앉아 하품을 한다. 망을 보는 모양이다.",
      "choices": [
        {
          "id": "back_way",
