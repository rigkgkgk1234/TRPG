    "mode": "cooldown",
    "days": 3
  },
  "dangerTier": 2,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "탑 뒤편 바위 그늘에 모닥불 재가 아직 따뜻하다. 주변에 뼈다귀와 깃털이 흩어져 있다.",
      "choices": [
        {
          "id": "search",
