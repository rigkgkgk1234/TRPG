            "stat": "agi",
            "dc": 13,
            "tags": [
              "goblin"
            ]
          },
          "outcomes": {
            "success": {
              "text": "바위 뒤로 몸을 숨기며 빠져나왔다.",
              "next": "END"
            },
            "fail": {
              "text": "놈이 코를 킁킁대더니 도끼를 치켜들었다!",
              "next": "fight"
            }
          }
        },
        {
          "id": "retreat",
          "label": "오늘은 탑을 포기하고 돌아간다",
          "outcome": {
            "text": "멀찍이 돌아 숲길로 빠져나왔다. 헛걸음이지만 목숨이 먼저다.",
            "effects": [
              {
                "type": "fatigue",
                "delta": 1
              },
              {
                "type": "endDay"
              }
            ],
            "next": "END"
          }
        }
      ]
    },
    "fight": {
      "text": "고블린 전사가 포효하며 도끼를 휘두른다.",
      "onEnter": [
        {
          "type": "startCombat",
          "combat": {
            "enemies": [
              "goblin_warrior"
            ],
            "initiative": "roll",
            "canFlee": true,
            "onVictory": "win",
            "onFled": "fled"
          }
        }
      ],
      "choices": []
    },
    "win": {
      "text": "고블린 전사가 무릎을 꿇고 쓰러졌다. 이런 놈이 몇이나 더 있을까.",
      "onEnter": [
        {
          "type": "reputation",
          "delta": 3
        }
      ],
      "choices": []
    },
    "fled": {
      "text": "돌계단을 구르듯 내려와 마을 쪽으로 내달렸다. 오늘 감시탑은 여기까지다.",
      "choices": []
    }
  }
