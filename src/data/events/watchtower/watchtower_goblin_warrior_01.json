{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "watchtower_goblin_warrior_01",
  "category": "explore",
  "region": "watchtower",
  "title": "탑을 차지한 고블린",
  "conditions": [
    {
      "type": "dayRange",
      "min": 14
    }
  ],
  "weight": 5,
  "repeat": {
    "mode": "cooldown",
    "days": 5
  },
  "dangerTier": 3,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "탑 입구에 고블린 전사가 버티고 섰다. 사람 키만 한 도끼를 어깨에 걸쳤다.",
      "choices": [
        {
          "id": "fight",
          "label": "맞선다",
          "outcome": {
            "next": "fight"
          }
        },
        {
          "id": "sneak",
          "label": "놈의 눈을 피해 물러난다",
