              "text": "어미 멧돼지가 수풀을 박차고 나왔다!",
              "next": "fight"
            }
          }
        },
        {
          "id": "grab",
          "label": "새끼 한 마리를 잡는다",
          "outcome": {
            "next": "fight"
          }
        },
        {
          "id": "away",
          "label": "왔던 길로 돌아간다",
