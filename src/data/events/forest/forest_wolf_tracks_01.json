{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "forest_wolf_tracks_01",
  "category": "explore",
  "region": "forest",
  "title": "진흙 위의 발자국",
  "conditions": [{ "type": "dayRange", "min": 2 }],
  "weight": 9,
  "repeat": { "mode": "cooldown", "days": 4 },
  "dangerTier": 1,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": {
        "variants": [
          { "when": [{ "type": "job", "job": "hunter" }], "text": "늑대 발자국이다. 크기로 보아 다 자란 수컷이고, 지나간 지 반나절도 안 됐다." }
        ],
        "fallback": "진흙 위에 개 발자국 같은 것이 줄지어 나 있다. 개치고는 너무 크다."
      },
      "choices": [
        {
          "id": "follow",
          "label": "발자국을 따라가 본다",
          "check": { "stat": "per", "skill": "tracking", "dc": 12, "allowPartial": true, "tags": ["beast"] },
          "outcomes": {
            "success": { "text": "바위 틈의 굴을 찾았다. 앞으로 이쪽은 피해 다녀야겠다.", "effects": [{ "type": "setFlag", "flag": "wolf_den_known" }], "next": "END" },
            "partial": { "text": "굴 근처까지 갔다가 으르렁 소리에 허겁지겁 물러났다.", "effects": [{ "type": "setFlag", "flag": "wolf_den_known" }, { "type": "fatigue", "delta": 1 }], "next": "END" },
            "fail": { "text": "발자국이 개울에서 끊겼다. 괜히 헤매기만 했다.", "effects": [{ "type": "fatigue", "delta": 2 }], "next": "END" },
            "critFail": { "text": "발자국만 보다가 비탈 아래로 굴러떨어졌다.", "effects": [{ "type": "wound", "steps": 1 }], "next": "END" }
          }
        },
        { "id": "avoid", "label": "발자국 반대쪽으로 간다", "outcome": { "text": "괜히 마주칠 필요는 없다.", "next": "END" } }
      ]
    }
  }
}
