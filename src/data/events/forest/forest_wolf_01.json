{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "forest_wolf_01",
  "category": "explore",
  "region": "forest",
  "title": "덤불 속의 눈",
  "conditions": [{ "type": "dayRange", "min": 2 }],
  "weight": 8,
  "repeat": { "mode": "cooldown", "days": 4 },
  "dangerTier": 1,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": {
        "variants": [
          { "when": [{ "type": "job", "job": "hunter" }], "text": "익숙한 냄새가 난다. 늑대 한 마리가 바람을 등지고 덤불 뒤에 숨어 있다." }
        ],
        "fallback": "덤불 사이로 누런 눈이 번뜩인다. 낮게 으르렁거리는 소리가 들린다."
      },
      "choices": [
        {
          "id": "shoot",
          "label": "먼저 활을 쏜다",
          "conditions": [{ "type": "equipped", "itemId": "hunting_bow" }],
          "cost": { "item": { "itemId": "arrow", "qty": 1 } },
          "check": { "stat": "agi", "skill": "bow", "dc": 12, "tags": ["beast"] },
          "outcomes": {
            "success": { "text": "화살이 늑대의 어깨에 꽂혔다!", "next": "fight_advantage" },
            "fail": { "text": "화살이 빗나갔다. 늑대가 달려든다!", "next": "fight" }
          }
        },
        {
          "id": "back_off",
          "label": "눈을 마주친 채 천천히 물러난다",
          "check": { "stat": "per", "skill": "tracking", "dc": 10, "allowPartial": true, "tags": ["beast"] },
          "outcomes": {
            "success": { "text": "늑대는 따라오지 않았다.", "next": "END" },
            "partial": { "text": "가시덤불에 긁혀 가며 겨우 물러났다.", "effects": [{ "type": "hp", "delta": -1 }, { "type": "fatigue", "delta": 1 }], "next": "END" },
            "fail": { "text": "등을 보인 순간, 늑대가 뛰어올랐다!", "next": "fight_ambushed" }
          }
        },
        {
          "id": "throw_food",
          "label": "말린 고기를 던져 준다",
          "conditions": [{ "type": "food", "min": 1 }],
          "cost": { "food": 1 },
          "outcome": { "text": "늑대는 고기를 물고 사라졌다. 오늘 저녁은 조금 모자라겠다.", "next": "END" }
        },
        { "id": "fight", "label": "무기를 들고 맞선다", "outcome": { "next": "fight" } }
      ]
    },
    "fight": {
      "text": "피할 수 없다. 무기를 고쳐 쥔다.",
      "onEnter": [{ "type": "startCombat", "combat": { "enemies": ["wolf"], "initiative": "roll", "canFlee": true, "onVictory": "win", "onFled": "fled" } }],
      "choices": []
    },
    "fight_advantage": {
      "text": "상처 입은 늑대가 다리를 절며 다가온다.",
      "onEnter": [{ "type": "startCombat", "combat": { "enemies": ["wolf"], "initiative": "player", "canFlee": true, "enemyHpModifier": -3, "onVictory": "win", "onFled": "fled" } }],
      "choices": []
    },
    "fight_ambushed": {
      "text": "날카로운 이빨이 등을 노린다!",
      "onEnter": [{ "type": "startCombat", "combat": { "enemies": ["wolf"], "initiative": "enemy", "canFlee": true, "onVictory": "win", "onFled": "fled" } }],
      "choices": []
    },
    "win": {
      "text": "숨을 몰아쉰다. 늑대가 다시 일어나지 않는 것을 보고서야 무기를 내렸다.",
      "onEnter": [{ "type": "incFlag", "flag": "wolves_killed", "delta": 1 }],
      "choices": []
    },
    "fled": {
      "text": "정신없이 달려 숲 어귀까지 나왔다. 오늘 숲은 여기까지다.",
      "choices": []
    }
  }
}
