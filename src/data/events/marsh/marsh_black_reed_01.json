        {
          "id": "dig",
          "label": "뿌리를 조심스레 캔다",
          "check": {
            "stat": "agi",
            "skill": "herbalism",
            "dc": 11
          },
          "outcomes": {
            "success": {
              "text": "즙이 묻지 않게 뿌리를 캐서 이파리로 쌌다. 약초로 쓸 만하다.",
              "effects": [
                {
                  "type": "addItem",
                  "itemId": "herb",
                  "qty": 2
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "즙이 손등에 튀었다. 한참을 물에 씻었다.",
              "effects": [
                {
                  "type": "hp",
                  "delta": -2
                },
                {
                  "type": "addItem",
                  "itemId": "herb",
                  "qty": 1
                }
              ],
              "next": "END"
            }
          }
        },
        {
          "id": "leave",
          "label": "손대지 않는다",
          "outcome": {
            "text": "갈대밭을 비켜 지나갔다.",
            "next": "END"
          }
        }
