        },
        {
          "id": "search",
          "label": "수레 앞쪽 마부석만 뒤진다",
          "outcome": {
            "text": "마부석 밑에서 동전 몇 개가 든 주머니를 찾았다.",
            "effects": [
              {
                "type": "silver",
                "delta": 2
              }
            ],
            "next": "END"
