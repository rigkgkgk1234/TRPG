          "outcomes": {
            "success": {
              "text": "행렬이 다 지나갔다. 짐에는 창과 횃불이 가득했다. 놈들이 싸움을 준비하고 있다.",
              "effects": [
                {
                  "type": "setFlag",
                  "flag": "goblin_tracks_found"
                },
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "처진 둘이 이쪽을 손가락질했다!",
              "next": "fight"
            }
          }
        },
        {
          "id": "fight",
          "label": "처진 둘을 덮친다",
          "outcome": {
            "next": "fight"
          }
        },
        {
          "id": "leave",
          "label": "멀리 돌아서 피한다",
          "outcome": {
            "text": "행렬과 반대쪽으로 크게 돌았다.",
            "effects": [
              {
                "type": "fatigue",
                "delta": 1
              }
            ],
            "next": "END"
          }
        }
      ]
    },
    "fight": {
