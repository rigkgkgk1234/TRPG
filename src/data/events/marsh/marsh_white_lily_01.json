            "stat": "per",
            "skill": "herbalism",
            "dc": 14,
            "allowPartial": true
          },
          "outcomes": {
            "success": {
              "text": "뿌리를 상하지 않게 캐냈다. 늪 약초 세 포기 값은 될 것이다.",
              "effects": [
                {
                  "type": "addItem",
                  "itemId": "rare_herb",
                  "qty": 3
                },
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            },
            "partial": {
              "text": "꽃만 꺾었다. 그래도 귀한 것이다.",
              "effects": [
                {
                  "type": "addItem",
                  "itemId": "rare_herb",
                  "qty": 1
                },
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "발밑이 꺼지며 깊은 물에 빠졌다. 정신없이 허우적거리다 기어 나왔다.",
              "effects": [
                {
                  "type": "hp",
                  "delta": -3
                },
                {
                  "type": "fatigue",
                  "delta": 2
                }
              ],
              "next": "END"
            }
          }
        },
        {
          "id": "leave",
          "label": "멀리서 보기만 한다",
          "outcome": {
            "text": "한참을 바라보다 돌아섰다.",
            "next": "END"
