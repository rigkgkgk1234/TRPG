            "partial": {
              "text": "녹슨 쇠 사이에서 은 장식 조각을 건졌다.",
              "effects": [
                {
                  "type": "addItem",
                  "itemId": "silver_scrap",
                  "qty": 1
                }
              ],
              "next": "END"
