{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "hamlet_raider_patrol_01",
  "category": "explore",
  "region": "hamlet",
  "title": "순찰하는 약탈병",
  "conditions": [],
  "weight": 4,
  "repeat": {
    "mode": "cooldown",
    "days": 7
  },
  "dangerTier": 3,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "고블린 약탈병 둘이 마을 어귀를 오가며 무언가를 기다린다. 하나는 둘둘 만 가죽을 허리에 차고 있다.",
      "choices": [
        {
          "id": "hide",
          "label": "숨어서 놈들이 하는 말을 엿듣는다",
          "check": {
            "stat": "agi",
            "dc": 13,
            "tags": [
              "goblin"
            ]
          },
          "outcomes": {
            "success": {
              "text": "놈들은 '보름'과 '방앗간 길'을 몇 번이고 되뇌었다. 그 말이 무슨 뜻인지 짐작이 간다.",
              "effects": [
                {
                  "type": "setFlag",
                  "flag": "goblin_tracks_found"
                },
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "돌멩이가 굴러 떨어졌다. 약탈병 둘이 동시에 돌아본다!",
              "next": "fight"
            }
          }
        },
        {
          "id": "fight",
          "label": "둘을 상대한다",
          "outcome": {
            "next": "fight"
          }
        },
        {
          "id": "back",
          "label": "멀찍이 돌아서 피한다",
          "outcome": {
            "text": "마을 바깥 둑길로 크게 돌아갔다.",
            "effects": [
              {
                "type": "fatigue",
                "delta": 1
              }
            ],
            "next": "END"
          }
        }
      ]
    },
    "fight": {
      "text": "약탈병 둘이 손도끼를 꺼내 들고 양쪽으로 갈라선다.",
      "onEnter": [
        {
          "type": "startCombat",
          "combat": {
            "enemies": [
              "goblin_raider",
              "goblin_raider"
            ],
            "initiative": "roll",
            "canFlee": true,
            "onVictory": "win",
            "onFled": "fled"
          }
        }
      ],
      "choices": []
    },
    "win": {
      "text": "약탈병 둘이 쓰러졌다. 허리에 찬 가죽에는 보리울로 들어가는 길이 그려져 있었다.",
      "onEnter": [
        {
          "type": "setFlag",
          "flag": "goblin_plan_known"
        }
      ],
      "choices": []
    },
    "fled": {
      "text": "무너진 담장을 넘어 정신없이 달아났다. 오늘 물레방아골은 여기까지다.",
      "choices": []
    }
  }
}
