                {
                  "type": "addItem",
                  "itemId": "silver_scrap",
                  "qty": 1
                },
                {
                  "type": "silver",
                  "delta": 2
                },
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "가로대가 부러졌다. 바닥까지 미끄러져 떨어졌다.",
              "effects": [
                {
                  "type": "hp",
                  "delta": -4
                },
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            }
          }
        },
        {
          "id": "leave",
          "label": "내려가지 않는다",
          "outcome": {
