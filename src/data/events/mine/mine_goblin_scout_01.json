{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "mine_goblin_scout_01",
  "category": "explore",
  "region": "mine",
  "title": "갱도를 엿보는 고블린",
  "conditions": [],
  "weight": 4,
  "repeat": {
    "mode": "cooldown",
    "days": 6
  },
  "dangerTier": 2,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "갱도 모퉁이에서 고블린 하나가 숯으로 벽에 무언가를 그리고 있다. 길을 표시하는 것 같다.",
      "onEnter": [
        {
          "type": "setFlag",
          "flag": "goblin_scout_seen"
        }
      ],
      "choices": [
        {
          "id": "fight",
          "label": "덮친다",
          "outcome": {
            "next": "fight"
          }
        },
        {
          "id": "watch",
          "label": "숨어서 무엇을 그리는지 본다",
          "check": {
            "stat": "agi",
            "dc": 12,
            "tags": [
              "goblin"
            ]
          },
          "outcomes": {
            "success": {
              "text": "고블린이 떠난 뒤 벽을 보니 갱도에서 산 너머로 빠지는 길이 표시돼 있었다.",
              "effects": [
                {
                  "type": "setFlag",
                  "flag": "goblin_tracks_found"
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "고블린이 고개를 돌렸다. 눈이 마주쳤다!",
              "next": "fight"
            }
          }
        },
        {
          "id": "leave",
          "label": "물러난다",
          "outcome": {
            "text": "고블린이 눈치채기 전에 물러났다.",
            "next": "END"
          }
        }
      ]
    },
    "fight": {
      "text": "고블린 정찰병이 단검을 뽑는다.",
      "onEnter": [
        {
          "type": "startCombat",
          "combat": {
            "enemies": [
              "goblin_scout"
            ],
            "initiative": "roll",
            "canFlee": true,
            "onVictory": "win", "onRouted": "routed",
            "onFled": "fled"
          }
        }
      ],
      "choices": []
    },
    "routed": { "text": "정찰병이 갱도 깊이 달아났다. 벽의 숯 그림은 산 너머로 이어지는 길을 가리키고 있었다.", "onEnter": [{ "type": "setFlag", "flag": "goblin_tracks_found" }], "choices": [] },
    "win": {
      "text": "정찰병이 쓰러졌다. 벽의 숯 그림은 산 너머로 이어지는 길을 가리키고 있었다.",
      "onEnter": [
        {
          "type": "setFlag",
          "flag": "goblin_tracks_found"
        }
      ],
      "choices": []
    },
    "fled": {
      "text": "갱도 입구의 빛을 향해 정신없이 달렸다. 오늘 은광은 여기까지다.",
      "choices": []
    }
  }
}
