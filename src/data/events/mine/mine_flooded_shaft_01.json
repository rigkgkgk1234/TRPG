            "partial": {
              "text": "상자는 무거워 은화만 한 줌 쥐고 돌아왔다.",
              "effects": [
                {
                  "type": "silver",
                  "delta": 2
                },
                {
                  "type": "fatigue",
                  "delta": 2
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "차가운 물에 다리가 굳었다. 겨우 되돌아 나왔다.",
              "effects": [
                {
                  "type": "hp",
                  "delta": -2
                },
                {
                  "type": "fatigue",
                  "delta": 2
                }
