            "fail": {
              "text": "중간에 숨이 막혀 주저앉았다. 기어서 되돌아 나왔다.",
              "effects": [
                {
                  "type": "hp",
                  "delta": -3
                },
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            }
