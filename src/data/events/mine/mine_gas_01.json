          "outcomes": {
            "success": {
              "text": "가스가 고인 갱도를 알아보고 옆길로 돌았다. 옆길 바닥에서 은 부스러기를 주웠다.",
              "effects": [
                {
                  "type": "addItem",
                  "itemId": "silver_scrap",
                  "qty": 1
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "눈앞이 핑 돌았다. 벽을 짚고 겨우 빠져나왔다.",
              "effects": [
                {
                  "type": "hp",
                  "delta": -2
                },
                {
                  "type": "fatigue",
                  "delta": 2
                }
              ],
              "next": "END"
            }
          }
        },
        {
          "id": "dash",
          "label": "숨을 참고 단숨에 지나간다",
          "check": {
            "stat": "con",
            "dc": 13
          },
          "outcomes": {
            "success": {
              "text": "가스가 고인 갱도를 지나자 아무도 손대지 않은 광석 더미가 있었다.",
              "effects": [
                {
                  "type": "addItem",
                  "itemId": "silver_scrap",
                  "qty": 2
                },
                {
                  "type": "fatigue",
                  "delta": 1
