{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "mine_goblin_scrawl_01",
  "category": "explore",
  "region": "mine",
  "title": "갱도 깊은 곳의 그림",
  "conditions": [
    {
      "type": "dayRange",
      "min": 18
    }
  ],
  "weight": 4,
  "repeat": {
    "mode": "cooldown",
    "days": 8
  },
  "dangerTier": 3,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "가장 깊은 갱도 벽에 피와 숯으로 그린 그림이 있다. 작은 사람 모양이 줄지어 있고, 그 끝에 지붕이 여럿 그려져 있다.",
      "choices": [
        {
          "id": "read",
          "label": "그림을 하나하나 헤아린다",
          "check": {
            "stat": "per",
            "dc": 13,
            "tags": [
              "goblin"
            ]
          },
          "outcomes": {
            "success": {
              "text": "줄지은 고블린은 서른이 넘고, 지붕 옆에는 보름달이 그려져 있다. 놈들이 언제, 어디로 올지 알았다.",
              "effects": [
                {
                  "type": "setFlag",
                  "flag": "goblin_plan_known"
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "무엇을 뜻하는지 알 수 없다. 오싹한 기분만 남았다.",
              "effects": [
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            }
          }
        },
        {
          "id": "leave",
          "label": "서둘러 빠져나온다",
          "outcome": {
            "text": "그림에서 눈을 떼고 갱도를 빠져나왔다.",
            "next": "END"
          }
        }
      ]
    }
  }
}
