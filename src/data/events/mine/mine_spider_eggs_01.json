            "onFled": "fled"
          }
        }
      ],
      "choices": []
    },
    "win": {
      "text": "어미 거미가 쓰러졌다. 남은 알주머니도 모두 태웠다.",
      "onEnter": [
        {
          "type": "fatigue",
          "delta": 1
        }
      ],
      "choices": []
    },
    "fled": {
      "text": "갱도 입구의 빛을 향해 정신없이 달렸다. 오늘 은광은 여기까지다.",
