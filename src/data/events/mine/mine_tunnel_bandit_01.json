        {
          "id": "talk",
          "label": "같은 처지라며 말을 건넨다",
          "check": {
            "stat": "cha",
            "dc": 13
          },
          "outcomes": {
            "success": {
              "text": "사내가 혀를 차더니 저쪽 갱도는 건드리지 말라며 길을 비켜 주었다.",
              "next": "END"
            },
            "fail": {
              "text": "사내가 코웃음을 쳤다. \"자루를 내놓든가, 맞든가.\"",
              "next": "fight"
            }
          }
        },
        {
          "id": "pay",
          "label": "은화 3개를 내밀고 지나간다",
          "conditions": [
            {
              "type": "silver",
              "min": 3
            }
          ],
          "cost": {
            "silver": 3
          },
          "outcome": {
            "text": "사내가 은화를 받아 넣고 턱짓으로 길을 내주었다.",
            "next": "END"
          }
        },
        {
          "id": "back",
          "label": "모퉁이 뒤로 물러난다",
          "outcome": {
            "text": "사내가 쫓아오기 전에 갱도 입구로 돌아 나왔다.",
            "effects": [
              {
                "type": "fatigue",
                "delta": 1
              }
            ],
            "next": "END"
          }
        }
      ]
    },
    "fight": {
      "text": "사내가 곡괭이 자루를 휘두르며 달려든다.",
      "onEnter": [
        {
          "type": "startCombat",
          "combat": {
            "enemies": [
              "tunnel_bandit"
            ],
            "initiative": "roll",
            "canFlee": true,
            "onVictory": "win",
            "onFled": "fled"
          }
        }
      ],
      "choices": []
    },
    "win": {
      "text": "도적이 자루를 버리고 어둠 속으로 달아났다.",
      "choices": []
    },
    "fled": {
      "text": "갱도 입구의 빛을 향해 정신없이 달렸다. 오늘 은광은 여기까지다.",
      "choices": []
    }
  }
