{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "mine_tunnel_bandit_01",
  "category": "explore",
  "region": "mine",
  "title": "갱도의 도적",
  "conditions": [],
  "weight": 5,
  "repeat": {
    "mode": "cooldown",
    "days": 5
  },
  "dangerTier": 2,
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "모퉁이를 돌자 등잔불 아래에서 사내가 은 부스러기를 자루에 담고 있다. 사내가 곡괭이 자루를 움켜쥐었다.",
