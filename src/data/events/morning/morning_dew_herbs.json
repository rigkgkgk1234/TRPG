              "next": "END"
            },
            "fail": {
              "text": "잡초였다. 어머니가 웃으시며 뽑아 버리셨다.",
              "next": "END"
            }
          }
        },
        {
          "id": "leave",
          "label": "그대로 둔다",
          "outcome": {
            "next": "END"
          }
        }
