              "effects": [
                {
                  "type": "skillXp",
                  "skill": "tracking",
                  "amount": 2
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "다들 술기운에 한 말이라 앞뒤가 맞지 않는다.",
              "next": "END"
            }
          }
        },
        {
          "id": "leave",
          "label": "흘려듣고 지나간다",
          "outcome": {
            "next": "END"
          }
        }
