            "stat": "per",
            "skill": "tracking",
            "dc": 12,
            "tags": [
              "beast"
            ]
          },
          "outcomes": {
            "success": {
              "text": "우리 문 걸쇠가 풀려 있었다. 단단히 걸어 두고 돌아오는 길에 양 주인과 마주쳤다. 주인이 연신 고맙다고 했다.",
              "effects": [
                {
                  "type": "reputation",
                  "delta": 2
                },
                {
                  "type": "fatigue",
                  "delta": 1
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "어둠 속을 한참 헤맸지만 아무것도 찾지 못했다.",
              "effects": [
                {
                  "type": "fatigue",
                  "delta": 2
                }
              ],
              "next": "END"
            }
          }
        },
        {
          "id": "sleep",
          "label": "창문을 닫고 다시 눕는다",
          "outcome": {
            "text": "울음소리는 새벽까지 이어졌다. 잠을 설쳤다.",
            "effects": [
              {
                "type": "fatigue",
                "delta": 1
              }
            ],
            "next": "END"
          }
        }
      ]
    }
