{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "story_recruiter_return",
  "category": "story",
  "title": "다시 온 모집관",
  "conditions": [
    {
      "type": "dayRange",
      "min": 25
    },
    {
      "type": "notFlag",
      "flag": "recruit_passed"
    }
  ],
  "weight": 1,
  "priority": 15,
  "repeat": {
    "mode": "once"
  },
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "모집관이 다시 마을에 들렀다. 로웬으로 돌아가기 전 마지막 시험이라고 한다.",
      "choices": [
        {
          "id": "trial",
          "label": "시험을 본다",
          "conditions": [
            {
              "type": "any",
              "of": [
                {
                  "type": "skill",
                  "skill": "blade",
                  "min": 3
                },
                {
                  "type": "skill",
                  "skill": "blunt",
                  "min": 3
                },
                {
                  "type": "skill",
                  "skill": "bow",
                  "min": 3
                }
              ]
            }
          ],
          "lockedReason": "무기 숙련 3레벨 필요",
          "check": {
            "stat": "str",
            "skill": "guard",
            "dc": 12
          },
          "outcomes": {
            "success": {
              "text": "\"이번엔 됐군.\" 모집관이 짧게 웃었다. 달이 바뀌기 전에 로웬으로 오라고 한다.",
              "effects": [
                {
                  "type": "setFlag",
                  "flag": "recruit_passed"
                }
              ],
              "next": "offer"
            },
            "fail": {
              "text": "이번에도 모집관은 고개를 저었다.",
              "next": "END"
            }
          }
        },
        {
          "id": "watch",
          "label": "그냥 보낸다",
          "outcome": {
            "text": "모집관의 깃발이 로웬 쪽으로 멀어졌다.",
            "next": "END"
          }
        }
      ]
    },
    "offer": {
      "text": "모집관이 로웬에서 기다리겠다며 증표를 내민다. 받으면 습격이 오는 밤에 마을에 없을 것이다.",
      "choices": [
        {
          "id": "accept",
          "label": "증표를 받는다",
          "outcome": {
            "text": "증표를 품에 넣었다. 어머니에게 어떻게 말을 꺼내야 할지 모르겠다.",
            "effects": [
              {
                "type": "setFlag",
                "flag": "route_rowen"
              }
            ],
            "next": "END"
          }
        },
        {
          "id": "decline",
          "label": "마을에 남겠다고 한다",
          "outcome": {
            "text": "모집관이 어깨를 으쓱하고 말에 올랐다.",
            "next": "END"
          }
        }
      ]
    }
  }
}
