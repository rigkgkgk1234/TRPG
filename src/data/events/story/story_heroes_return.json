      "text": {
        "variants": [
          {
            "when": [
              {
                "type": "flag",
                "flag": "heroes_helped"
              }
            ],
            "text": "용사 일행이 북쪽에서 돌아왔다. 아델이 멀리서 이쪽을 알아보고 손을 흔든다. 그런데 궁수가 보이지 않는다."
          }
        ],
        "fallback": "용사 일행이 북쪽에서 돌아왔다. 다들 지쳐 보이고, 떠날 때 함께 있던 궁수가 보이지 않는다."
      },
      "choices": [],
      "autoNext": "ask"
    },
    "ask": {
      "text": "궁수 미라는 용의 불길에 다쳐 로웬 신전에 남았다고 한다. 아델은 다음 원정에 함께할 사람을 찾는다며, 실력을 보여 달라고 한다.",
      "choices": [
        {
          "id": "blade",
          "label": "검으로 시험을 청한다",
          "conditions": [
            {
              "type": "skill",
              "skill": "blade",
              "min": 2
            },
            {
              "type": "any",
              "of": [
                {
                  "type": "skill",
                  "skill": "blade",
                  "min": 3
                },
                {
                  "type": "flag",
                  "flag": "heroes_helped"
                }
              ]
            }
          ],
          "lockedReason": "검술 3레벨 필요 (일행을 도왔다면 2레벨)",
          "check": {
            "stat": "str",
            "skill": "blade",
            "dc": 13
          },
          "outcomes": {
            "success": {
              "text": "아델이 목검을 내리고 고개를 끄덕였다.",
              "next": "offer"
            },
            "fail": {
              "text": "아델이 고개를 저었다. \"아직은 아니야. 그래도 나쁘지 않았어.\"",
              "next": "END"
            }
          }
        },
