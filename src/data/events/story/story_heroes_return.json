{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "story_heroes_return",
  "category": "story",
  "title": "돌아온 용사 일행",
  "conditions": [
    {
      "type": "dayRange",
      "min": 19
    },
    {
      "type": "flag",
      "flag": "heroes_met"
    }
  ],
  "weight": 1,
  "priority": 12,
  "repeat": {
