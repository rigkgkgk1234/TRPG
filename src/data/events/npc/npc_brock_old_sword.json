{
  "$schema": "../../../../schemas/event.schema.json",
  "id": "npc_brock_old_sword",
  "category": "npc",
  "npc": "brock",
  "title": "구석의 녹슨 검",
  "conditions": [
    {
      "type": "dayRange",
      "min": 5
    }
  ],
  "weight": 5,
  "repeat": {
    "mode": "once"
  },
  "startScene": "start",
  "scenes": {
    "start": {
      "text": "대장간 구석에 녹슨 검 한 자루가 세워져 있다. 주인이 찾으러 오지 않는다며 브록이 싸게 넘기겠다고 한다.",
      "choices": [
        {
          "id": "buy",
          "label": "은화 10개에 산다",
          "cost": {
            "silver": 10
          },
          "outcome": {
            "text": "브록이 날을 한 번 갈아서 건네주었다. 녹은 슬었어도 손에 감기는 맛이 있다.",
            "effects": [
              {
                "type": "addItem",
                "itemId": "rusty_sword",
                "qty": 1
              }
            ],
            "next": "END"
          }
        },
        {
          "id": "haggle",
          "label": "녹을 짚어 가며 값을 깎는다",
          "conditions": [
            {
              "type": "job",
              "job": "peddler"
            },
            {
              "type": "notFlag",
              "flag": "brock_haggled"
            }
          ],
          "hideIfLocked": true,
          "cost": {
            "silver": 6
          },
          "check": {
            "stat": "cha",
            "skill": "haggle",
            "dc": 11
          },
          "outcomes": {
            "success": {
              "text": "녹이 슨 곳을 몇 번 짚었더니 브록이 손을 들었다. 은화 6개에 검을 넘겨받았다.",
              "effects": [
                {
                  "type": "addItem",
                  "itemId": "rusty_sword",
                  "qty": 1
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "브록이 값은 못 깎는다며 은화를 도로 밀어 주었다.",
              "effects": [
                {
                  "type": "silver",
                  "delta": 6
                },
                {
                  "type": "setFlag",
                  "flag": "brock_haggled"
                }
              ],
              "next": "start"
            }
          }
        },
        {
          "id": "leave",
          "label": "돈이 없다며 사양한다",
          "outcome": {
            "next": "END"
          }
        }
      ]
    }
  }
}
