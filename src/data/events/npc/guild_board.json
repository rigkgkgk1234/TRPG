    "goblin_win": {
      "text": "고블린 전사의 귀걸이를 증표로 가져왔다. 중개소가 술렁인다.",
      "onEnter": [
        {
          "type": "silver",
          "delta": 14
        },
        {
          "type": "fame",
          "delta": 8
        }
      ],
      "choices": []
