            "initiative": "roll",
            "canFlee": true,
            "onVictory": "rats_win",
            "onFled": "fled"
          }
        }
      ],
      "choices": []
    },
    "rats_win": {
      "text": "쥐를 잡아 꼬리째 방앗간 주인에게 내밀었다. 주인이 질색하며 품삯을 쥐여 준다.",
      "onEnter": [
        {
          "type": "silver",
