  "startScene": "start",
  "scenes": {
    "start": {
      "text": "여관 옆 작은 중개소. 게시판에 의뢰 쪽지가 빼곡하다. 중개인 오스카가 이름값에 맞는 일만 내준다며 장부를 펼친다. 이름이 알려질수록 큰일이 들어온다.",
      "choices": [
        {
          "id": "letter",
          "label": "이웃 마을 편지 배달 (은화 3, 명성 +2)",
          "conditions": [
            {
              "type": "fame",
              "min": 10,
              "max": 29
            }
          ],
          "cost": {
            "fatigue": 2
          },
          "check": {
            "stat": "agi",
            "dc": 10
          },
          "outcomes": {
            "success": {
              "text": "해 지기 전에 편지를 전하고 답장까지 받아 왔다.",
              "effects": [
                {
                  "type": "silver",
                  "delta": 3
                },
                {
                  "type": "fame",
                  "delta": 2
                }
              ],
              "next": "END"
            },
            "fail": {
              "text": "길을 헤매다 늦게 도착했다. 품삯이 깎였다.",
              "effects": [
                {
                  "type": "silver",
                  "delta": 1
                }
              ],
              "next": "END"
            }
          },
          "hideIfLocked": true
        },
        {
          "id": "rats",
          "label": "방앗간 쥐 소탕 (은화 4, 명성 +3)",
