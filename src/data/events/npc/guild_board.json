            {
              "type": "fame",
              "min": 30
            }
          ],
          "cost": {
            "fatigue": 2
          },
          "outcome": {
            "next": "bandit_fight"
          },
          "hideIfLocked": true
        },
        {
          "id": "goblin",
          "label": "고블린 전사 토벌 (은화 14, 명성 +8)",
          "conditions": [
            {
              "type": "fame",
              "min": 40
            }
          ],
          "cost": {
            "fatigue": 2
          },
          "outcome": {
            "next": "goblin_fight"
          },
          "hideIfLocked": true
        },
        {
          "id": "leave",
          "label": "게시판만 보고 돌아간다",
          "outcome": {
            "text": "다음에 맡을 만한 일을 눈여겨봐 두었다.",
            "next": "END"
          }
        }
