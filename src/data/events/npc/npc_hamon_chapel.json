            "stat": "per",
            "skill": "herbalism",
            "dc": 11
          },
          "outcomes": {
            "success": {
              "text": "열이 오른 아이의 이마에 약초 찜질을 얹었다. 새벽녘에 열이 내렸다.",
              "effects": [
                {
                  "type": "reputation",
                  "delta": 3
                }
              ],
              "next": "END"
